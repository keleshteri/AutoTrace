{
  "name": "autotrace",
  "private": true,
  "version": "0.1.1",
  "description": "Privacy-first local-only automatic time tracker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:unit && npm run test:rust",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check:ipc": "node scripts/check-ipc.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:unit && npm run test:rust && npm run test:e2e",
    "release:local": "bash scripts/release-local.sh",
    "release:bump": "bash scripts/bump-version.sh",
    "ai:sidecar": "npm --prefix ai-sidecar start",
    "ai:sidecar:install": "npm --prefix ai-sidecar install"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
