{
  "name": "autotrace",
  "private": true,
  "version": "0.1.1",
  "description": "Privacy-first local-only automatic time tracker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
